<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);WFO1000</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ECMS.Business\ECMS.Business.csproj" />
      <ProjectReference Include="..\ECMS.Core\ECMS.Core.csproj" />
      <ProjectReference Include="..\ECMS.Data\ECMS.Data.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ClosedXML" Version="0.105.1" />
      <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Controls\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Forms\LoginForm.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

</Project>
